    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    padding:20px;
  }

  /* ***************** START 1 ***************** */
  .experiment1 {
    width:100%;
    max-width:918px;
    height:auto;
    margin: 20px auto;
