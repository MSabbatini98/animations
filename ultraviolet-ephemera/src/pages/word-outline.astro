  .experiment2 svg {
    display:block;
    width:100%;
    height:auto;
    max-width:100%;
  }

  .experiment1 svg path{
    fill: transparent;
    stroke: blue;
    stroke-width: 1.2;
    stroke-dasharray: 270;
    stroke-dashoffset: 270;
    animation: textAnimation 3s ease-in forwards;
  }

  @keyframes textAnimation {
    0% {
      stroke-dashoffset: 270;
    }
    50% {
      fill: transparent;
    }
    100% {
      stroke-dashoffset: 0;
      fill: blue;
    }
  } 
