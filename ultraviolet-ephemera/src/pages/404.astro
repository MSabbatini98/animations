---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 - Page Not Found">
  <main class="not-found">
    <h1>404</h1>
    <p>Sorry for the inconvenience ths may have caused, the page you are looking for does not exist.</p>
    <a href="/">Go back home</a>
  </main>
</Layout>

<style>
  .not-found {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }

  h1 {
    font-size: 6rem;
    margin: 0;
  }

  p {
    font-size: 1.2rem;
  }

  a {
    text-decoration: underline;
  }
</style>